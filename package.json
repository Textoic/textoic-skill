{
  "name": "textoic-skill",
  "version": "0.8.2",
  "description": "Writes English prose to a house style with the enlint rule set. Puts the style card in the agent's instructions, lints every answer and every document it writes for free, and rewrites flagged documents in the background on the harness's own cheap model.",
  "license": "MIT",
  "author": "Luis Fominaya (https://github.com/fpluis)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Textoic/textoic-skill.git"
  },
  "homepage": "https://github.com/Textoic/textoic-skill",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "enlint": "./bin/enlint.mjs"
  },
  "scripts": {
    "build": "tsc && node scripts/bundle.mjs",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx/esm test/**/*.test.ts",
    "enlint": "node ./bin/enlint.mjs",
    "install-claude": "node ./scripts/install.mjs claude",
    "install-codex": "node ./scripts/install.mjs codex"
  },
  "dependencies": {
    "@textoic/enlint": "^0.2.0",
    "@textoic/artisan": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "22.18.1",
    "esbuild": "0.25.12",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  }
}
